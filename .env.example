# ---------------------------------------------------------------------------
# Backend (server/) environment. Copy to server/.env — NEVER put these in the app.
# The mobile app only stores the backend URL (Settings → AI 문제 생성 서버).
# ---------------------------------------------------------------------------

# LLM for question generation + independent critic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# server-side refusal fallbacks (beta); set to "off" to disable
ANTHROPIC_FALLBACKS=on

# Neural TTS for listening items: openai | elevenlabs (leave empty = device TTS in the app)
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_IDS={"M-us":"...","W-us":"...","M-gb":"...","W-gb":"..."}

# Optional light abuse guard. The app sends it when the URL is entered as
# https://your-host?token=<APP_TOKEN>. It is NOT a secret once shipped in a URL.
APP_TOKEN=
RATE_PER_MINUTE=20
MAX_SPECS_PER_REQUEST=6
PORT=8787
